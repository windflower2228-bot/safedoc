'use client'

import { useState, useEffect } from 'react'
import { useRouter } from 'next/navigation'
import Link from 'next/link'
import { toast } from 'sonner'
import {
  FlaskConical, ArrowLeft, BookOpen, Edit2,
  Download, Globe, AlertTriangle, Loader2,
  Shield, Flame, Zap, Wind,
} from 'lucide-react'
import {
  GHS_LABELS, GHS_COLORS,
  type GhsHazardClass, type MsdsRecord,
} from '@/types/msds'

export default function MsdsDetailPage({ params }: { params: { id: string } }) {
  const router = useRouter()
  const [msds,    setMsds]    = useState<MsdsRecord | null>(null)
  const [loading, setLoading] = useState(true)
  const [genEdu,  setGenEdu]  = useState(false)

  useEffect(() => {
    fetch(`/api/documents/msds/${params.id}`)
      .then(r => r.json())
      .then(j => { setMsds(j.data); setLoading(false) })
  }, [params.id])

  async function handleGenEdu() {
    setGenEdu(true)
    const res  = await fetch(`/api/documents/msds/${params.id}/generate-edu`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ save: true }),
    })
    const json = await res.json()
    setGenEdu(false)
    if (!res.ok) { toast.error(json.error); return }
    toast.success('MSDS 교육일지가 생성되었습니다!')
    router.push(`/documents/education/${json.data.id}`)
  }

  if (loading) return (
    <div className="flex items-center justify-center h-48">
      <Loader2 className="w-6 h-6 animate-spin text-gray-300" />
    </div>
  )
  if (!msds) return <div className="text-center text-gray-400 py-16">MSDS를 찾을 수 없습니다.</div>

  const hazards = (msds.ghs_hazards ?? []) as GhsHazardClass[]

  return (
    <div className="max-w-3xl mx-auto space-y-4">
      {/* 헤더 */}
      <div className="flex items-center justify-between">
        <div className="flex items-center gap-3">
          <Link href="/documents/msds"
            className="p-1.5 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-lg">
            <ArrowLeft className="w-4 h-4" />
          </Link>
          <div>
            <h1 className="text-xl font-bold text-gray-900 flex items-center gap-2">
              <FlaskConical className="w-5 h-5 text-cyan-600" />
              {msds.product_name}
            </h1>
            <div className="flex items-center gap-2 mt-0.5">
              {msds.cas_number && (
                <span className="text-xs text-gray-400 font-mono">CAS {msds.cas_number}</span>
              )}
              {msds.is_public && (
                <span className="flex items-center gap-1 text-xs text-cyan-600 bg-cyan-50 px-2 py-0.5 rounded-full">
                  <Globe className="w-3 h-3" /> 공용 자료
                </span>
              )}
              {msds.signal_word && (
                <span className={`text-xs font-semibold px-2 py-0.5 rounded-full ${
                  msds.signal_word === 'danger'
                    ? 'bg-red-100 text-red-700'
                    : 'bg-amber-100 text-amber-700'
                }`}>
                  {msds.signal_word === 'danger' ? '위험' : '경고'}
                </span>
              )}
            </div>
          </div>
        </div>
        <div className="flex gap-2">
          {msds.file_url && (
            <a href={msds.file_url} download={msds.file_name}
              className="btn-secondary text-sm gap-1.5">
              <Download className="w-4 h-4" /> 원본 다운로드
            </a>
          )}
          <button onClick={handleGenEdu} disabled={genEdu}
            className="btn-primary text-sm gap-1.5"
            style={{ background: '#2563eb' }}>
            {genEdu ? <Loader2 className="w-4 h-4 animate-spin" /> : <BookOpen className="w-4 h-4" />}
            교육일지 자동 생성
          </button>
          <Link href={`/documents/msds/${params.id}/edit`}
            className="btn-secondary text-sm gap-1.5">
            <Edit2 className="w-4 h-4" /> 편집
          </Link>
        </div>
      </div>

      {/* GHS 유해성 배지 */}
      {hazards.length > 0 && (
        <div className="card p-4">
          <h2 className="text-sm font-semibold text-gray-700 mb-3">GHS 유해·위험성 분류</h2>
          <div className="flex flex-wrap gap-2">
            {hazards.map(h => {
              const c = GHS_COLORS[h]
              return (
                <span key={h}
                  className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium ${c.bg} ${c.text}`}>
                  {GHS_LABELS[h]}
                </span>
              )
            })}
          </div>
        </div>
      )}

      {/* 기본정보 */}
      <div className="card p-5">
        <h2 className="text-sm font-semibold text-gray-700 mb-3">제품 기본정보</h2>
        <dl className="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          {[
            ['제품명',       msds.product_name],
            ['제품 코드',    msds.product_code],
            ['CAS 번호',     msds.cas_number],
            ['UN 번호',      msds.un_number],
            ['제조사',       msds.manufacturer],
            ['주요 구성성분', msds.main_components],
            ['노출기준',     msds.exposure_limit],
            ['개정일',       msds.revision_date],
          ].map(([label, value]) => value ? (
            <div key={label}>
              <dt className="text-xs text-gray-400">{label}</dt>
              <dd className="text-gray-800 mt-0.5 font-mono text-xs">{value}</dd>
            </div>
          ) : null)}
        </dl>
      </div>

      {/* 응급조치 */}
      {(msds.first_aid_eye || msds.first_aid_skin || msds.first_aid_inhale) && (
        <div className="card p-5">
          <h2 className="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-1.5">
            <AlertTriangle className="w-4 h-4 text-red-400" /> 응급조치 요령
          </h2>
          <div className="space-y-3 text-sm">
            {[
              ['눈 접촉',  msds.first_aid_eye],
              ['피부 접촉', msds.first_aid_skin],
              ['흡입',     msds.first_aid_inhale],
              ['섭취',     msds.first_aid_ingest],
            ].map(([label, value]) => value ? (
              <div key={label} className="flex gap-3">
                <span className="text-xs text-gray-400 w-14 flex-shrink-0 pt-0.5">{label}</span>
                <span className="text-gray-700 leading-relaxed">{value}</span>
              </div>
            ) : null)}
          </div>
        </div>
      )}

      {/* 취급·저장 + 보호구 */}
      {(msds.handling_storage || msds.ppe_required || msds.fire_fighting) && (
        <div className="card p-5">
          <h2 className="text-sm font-semibold text-gray-700 mb-3 flex items-center gap-1.5">
            <Shield className="w-4 h-4 text-green-500" /> 취급·안전 정보
          </h2>
          <div className="space-y-3 text-sm">
            {msds.ppe_required && (
              <div>
                <div className="text-xs text-gray-400 mb-1">필요 보호구</div>
                <div className="text-gray-700 bg-green-50 rounded-lg px-3 py-2">{msds.ppe_required}</div>
              </div>
            )}
            {msds.handling_storage && (
              <div>
                <div className="text-xs text-gray-400 mb-1">취급·저장 주의사항</div>
                <div className="text-gray-700 whitespace-pre-line">{msds.handling_storage}</div>
              </div>
            )}
            {msds.fire_fighting && (
              <div>
                <div className="text-xs text-gray-400 mb-1">소화방법</div>
                <div className="text-gray-700">{msds.fire_fighting}</div>
              </div>
            )}
            {msds.spill_handling && (
              <div>
                <div className="text-xs text-gray-400 mb-1">누출 시 조치</div>
                <div className="text-gray-700">{msds.spill_handling}</div>
              </div>
            )}
          </div>
        </div>
      )}

      {/* 교육일지 생성 CTA */}
      <div className="flex items-center gap-3 p-4 bg-blue-50 border border-blue-200 rounded-xl">
        <BookOpen className="w-5 h-5 text-blue-600 flex-shrink-0" />
        <div className="flex-1">
          <p className="text-sm font-medium text-blue-800">MSDS 교육일지 자동 생성</p>
          <p className="text-xs text-blue-600 mt-0.5">
            이 MSDS 정보를 바탕으로 산업안전보건법 제116조에 따른 교육일지를 즉시 생성합니다.
          </p>
        </div>
        <button onClick={handleGenEdu} disabled={genEdu}
          className="btn-primary text-sm flex-shrink-0">
          {genEdu ? <><Loader2 className="w-4 h-4 animate-spin" /> 생성 중...</> : '교육일지 생성 →'}
        </button>
      </div>
    </div>
  )
}
