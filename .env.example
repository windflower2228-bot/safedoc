# ─────────────────────────────────────────────────────────────
# SafeDoc v20 환경변수
# cp .env.example .env.local 후 값 입력
# ─────────────────────────────────────────────────────────────

# ── 필수: Supabase ────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── 필수: 앱 URL ──────────────────────────────────────────────
# 로컬: http://localhost:3000
# 배포: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── 필수: Anthropic Claude API ───────────────────────────────
# https://console.anthropic.com 에서 발급
# 사용 기능: 수시평가 AI 사진 분석, MSDS 법적 분류, 경고표지 생성,
#            특별관리물질 판정, 작업일보 분석
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── 필수: Cron 보안 시크릿 ────────────────────────────────────
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=your-32-char-random-secret-here

# ── 선택: 이메일 알림 (Resend) ───────────────────────────────
# https://resend.com — 무료 3,000건/월
# 없으면 이메일 알림 비활성화 (나머지 기능 정상)
RESEND_API_KEY=re_...
EMAIL_FROM=SafeDoc <noreply@yourdomain.com>

# ── 선택: 카카오 알림톡 (Solapi) ─────────────────────────────
# https://solapi.com — 설정 순서:
# 1. 카카오 채널 개설 (business.kakao.com)
# 2. Solapi 가입 + API Key 발급
# 3. 알림톡 템플릿 등록 (심사 3~5 영업일)
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_SENDER_PHONE=
KAKAO_SENDER_KEY=
KAKAO_PF_ID=
KAKAO_ACTIVITY_TEMPLATE_ID=
